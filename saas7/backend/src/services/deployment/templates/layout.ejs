<!DOCTYPE html>
<html lang="<%= store.language || 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= store.name %> - <%= settings?.seo?.title || 'Online Store' %></title>
  <meta name="description" content="<%= settings?.seo?.description || store.name %>">
  <link rel="icon" href="<%= store.favicon || '' %>">
  <meta property="og:title" content="<%= store.name %>">
  <meta property="og:description" content="<%= settings?.seo?.description || store.name %>">
  <meta property="og:image" content="<%= store.logo || settings?.brand?.logo || '' %>">
  <meta property="og:url" content="<%= `${baseUrl}/stores/${store.slug}` %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/stores/<%= store.slug %>/assets/global.css?v=4">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --primary-color: <%= settings?.styling?.primaryColor || '#f97316' %>; --secondary-color: <%= settings?.styling?.secondaryColor || '#1a1509' %>; }
  </style>

  <!-- ================================================================ -->
  <!-- ✅ FIX: STORE CONFIG IN HEAD (Runs BEFORE app.js)               -->
  <!-- ================================================================ -->
  <script>
    window.__STORE_CONFIG__ = {
      storeSlug: '<%= store.slug %>',
      storeId: '<%= store._id %>',
      apiBase: '/api',
      currency: '<%= store.currency || "INR" %>',
    };
    console.log('✅ [layout] __STORE_CONFIG__ defined in HEAD:', window.__STORE_CONFIG__);
  </script>
</head>
<body>
  <header class="store-header">
    <div class="container">
      <div class="header-inner">
        <div class="logo">
          <a href="/stores/<%= store.slug %>">
            <% if (store.logo || settings?.brand?.logo) { %>
              <img src="<%= store.logo || settings?.brand?.logo %>" alt="<%= store.name %>">
            <% } else { %>
              <span class="logo-text"><%= store.name %></span>
            <% } %>
          </a>
        </div>
        
        <!-- Desktop Navigation -->
        <nav class="header-nav desktop-nav">
          <a href="/stores/<%= store.slug %>">Home</a>
          <a href="/stores/<%= store.slug %>/products.html">Products</a>
          <a href="/stores/<%= store.slug %>/cart.html">Cart</a>
          <a href="/stores/<%= store.slug %>/orders.html">Orders</a>
        </nav>

        <div class="header-actions">
          <a href="/stores/<%= store.slug %>/cart.html" class="cart-icon" aria-label="Shopping Cart">
            <svg class="cart-svg-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span id="cart-count">0</span>
          </a>
          <div id="auth-buttons" class="desktop-auth">
            <a href="/stores/<%= store.slug %>/login.html">Login</a>
            <a href="/stores/<%= store.slug %>/register.html">Register</a>
          </div>
          
          <!-- Mobile Hamburger Toggle Button -->
          <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open Navigation Menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Full-Screen Animated Overlay Menu -->
    <div class="mobile-nav-overlay" id="mobile-nav-overlay">
      <div class="mobile-nav-header">
        <span class="mobile-nav-brand"><%= store.name %></span>
        <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Close Navigation Menu">&times;</button>
      </div>
      <nav class="mobile-nav-links">
        <a href="/stores/<%= store.slug %>" class="mobile-nav-link">Home</a>
        <a href="/stores/<%= store.slug %>/products.html" class="mobile-nav-link">Products</a>
        <a href="/stores/<%= store.slug %>/cart.html" class="mobile-nav-link">Cart (<span id="mobile-cart-count">0</span>)</a>
        <a href="/stores/<%= store.slug %>/orders.html" class="mobile-nav-link">Orders</a>
      </nav>
      <div class="mobile-nav-auth" id="mobile-auth-buttons">
        <a href="/stores/<%= store.slug %>/login.html" class="mobile-btn-outline">Login</a>
        <a href="/stores/<%= store.slug %>/register.html" class="mobile-btn-primary">Register</a>
      </div>
    </div>
  </header>

  <main>
    <%- content %>
  </main>

  <footer class="store-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/stores/<%= store.slug %>" class="footer-brand-title">
            <%= settings?.brand?.name || store.name %>
          </a>
          <p class="footer-brand-tagline"><%= settings?.brand?.tagline || 'Curated essentials & timeless collections crafted with distinction.' %></p>
        </div>
        <div class="footer-links">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/stores/<%= store.slug %>">Home</a></li>
            <li><a href="/stores/<%= store.slug %>/products.html">Products</a></li>
            <li><a href="/stores/<%= store.slug %>/cart.html">Cart</a></li>
            <li><a href="/stores/<%= store.slug %>/orders.html">Orders</a></li>
            <li><a href="/stores/<%= store.slug %>/products.html">Privacy Policy</a></li>
            <li><a href="/stores/<%= store.slug %>/products.html">Terms of Service</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Contact</h4>
          <% if (settings?.footer?.address) { %>
            <p>
              <svg class="footer-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span><%= settings.footer.address %></span>
            </p>
          <% } %>
          <% if (settings?.footer?.phone) { %>
            <p>
              <svg class="footer-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <a href="tel:<%= settings.footer.phone %>"><%= settings.footer.phone %></a>
            </p>
          <% } %>
          <% if (settings?.footer?.email) { %>
            <p>
              <svg class="footer-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <a href="mailto:<%= settings.footer.email %>"><%= settings.footer.email %></a>
            </p>
          <% } %>
        </div>
        <div class="footer-social">
          <h4>Follow Us</h4>
          <div class="social-links">
            <% if (settings?.footer?.socialLinks?.facebook) { %>
              <a href="<%= settings.footer.socialLinks.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg class="footer-icon social-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            <% } %>
            <% if (settings?.footer?.socialLinks?.instagram) { %>
              <a href="<%= settings.footer.socialLinks.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg class="footer-icon social-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            <% } %>
            <% if (settings?.footer?.socialLinks?.twitter) { %>
              <a href="<%= settings.footer.socialLinks.twitter %>" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
                <svg class="footer-icon social-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733-16zM4 20l6.768-6.768M20 4l-6.768 6.768"></path></svg>
              </a>
            <% } %>
            <% if (settings?.footer?.socialLinks?.youtube) { %>
              <a href="<%= settings.footer.socialLinks.youtube %>" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg class="footer-icon social-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              </a>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Signature Giant Display Brand Title (Lumintora Luxury Watermark Style) -->
      <div class="footer-brand-display">
        <h2 class="footer-display-title"><%= settings?.brand?.name || store.name %></h2>
      </div>

      <div class="footer-bottom">
        <p><%= settings?.footer?.copyright || `© ${new Date().getFullYear()} ${settings?.brand?.name || store.name}. All rights reserved.` %></p>
        <div class="footer-legal-links">
          <a href="/stores/<%= store.slug %>/products.html">Privacy Policy</a>
          <a href="/stores/<%= store.slug %>/products.html">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ================================================================ -->
  <!-- ✅ app.js LOADS AT THE VERY END                                  -->
  <!-- ================================================================ -->
  <script src="/stores/<%= store.slug %>/assets/app.js?v=4"></script>
</body>
</html>